# QMDR — custom OpenAI-compatible endpoint
# Qwen3-Embedding-8B (2048 dims) + Qwen3-Reranker-8B
#
# Usage:
#   mkdir -p ~/.config/qmd
#   cp .env.qwen3.example ~/.config/qmd/.env
#   # edit: fill BASE_URL + API_KEY (below)
#   qmd doctor          # check providers, models, dimensions
#   qmd embed -f        # rebuild vectors — required when model or dims change
#   qmd query "你的问题" --profile
#
# Keep comments on their own line. There is no inline-comment stripping:
# `FOO=bar  # note` sets FOO to "bar  # note".

# ============================================================
# Endpoint — fill these two
# ============================================================
# Must serve: POST /v1/embeddings, POST /v1/chat/completions, POST /v1/rerank
QMD_OPENAI_BASE_URL=https://your-endpoint/v1
QMD_OPENAI_API_KEY=sk-xxx

# ============================================================
# Embedding — Qwen3-Embedding-8B truncated to 2048 dims
# ============================================================
QMD_EMBED_PROVIDER=openai
QMD_OPENAI_EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# Sent as the `dimensions` field on every embedding request.
# Drop this line if your endpoint already returns 2048, or rejects the field.
QMD_EMBED_DIMENSIONS=2048

# Qwen3 prompt format: `Instruct: ...\nQuery: ...` on queries, raw text on docs.
# Auto-detected from the model name; set explicitly if you renamed the model.
QMD_EMBED_PROMPT_STYLE=qwen3

# ============================================================
# Reranker — Qwen3-Reranker-8B via a dedicated /rerank endpoint
# ============================================================
# The "siliconflow" slot is a generic Cohere-style client:
# POST {base}/rerank  {model, query, documents, top_n} -> results[].relevance_score
# Works with vLLM, SiliconFlow, Jina, TEI style gateways.
# Do NOT use QMD_RERANK_MODE=llm — that is chat completions, which a
# cross-encoder like Qwen3-Reranker cannot serve.
QMD_RERANK_PROVIDER=siliconflow
QMD_RERANK_MODE=rerank
QMD_SILICONFLOW_BASE_URL=https://your-endpoint/v1
QMD_SILICONFLOW_API_KEY=sk-xxx
QMD_SILICONFLOW_RERANK_MODEL=Qwen/Qwen3-Reranker-8B

# ============================================================
# Query expansion — OPTIONAL
# ============================================================
# Works only if your endpoint serves a chat model. Left unset, any
# SiliconFlow key makes this slot fall back to zai-org/GLM-4.5-Air — a
# SiliconFlow model your endpoint probably does not serve.
QMD_QUERY_EXPANSION_PROVIDER=openai
QMD_OPENAI_MODEL=Qwen/Qwen3-8B
# No chat model? Turn it off. Only expansion is skipped; BM25 + vector search still run:
# QMD_QUERY_EXPANSION_PROVIDER=none

# ============================================================
# Timeouts / tuning
# ============================================================
QMD_TIMEOUT_MS=60000
QMD_EMBED_BATCH_SIZE=16
QMD_RERANK_DOC_LIMIT=40
QMD_RERANK_CHUNKS_PER_DOC=3
